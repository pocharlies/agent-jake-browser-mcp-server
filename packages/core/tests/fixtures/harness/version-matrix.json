{
  "_comment": "Fixed compatibility matrix for the negotiated wire. IDENTICAL file in both repos (server: packages/core/tests/fixtures/harness, extension: vendor/protocol); edit both together (reviewed contract change). `cases` = server view (a client says hello); `extensionView` = extension view (a server of this kind answers the extension's hello). catalog: current|stale.",
  "serverWireVersions": [
    1
  ],
  "cases": [
    {
      "name": "new/new same version",
      "client": [
        1
      ],
      "catalog": "current",
      "expect": "ack",
      "protocolVersion": 1
    },
    {
      "name": "maximum intersection (client offers a newer one too)",
      "client": [
        3,
        2,
        1
      ],
      "catalog": "current",
      "expect": "ack",
      "protocolVersion": 1
    },
    {
      "name": "order independent",
      "client": [
        1,
        2,
        3
      ],
      "catalog": "current",
      "expect": "ack",
      "protocolVersion": 1
    },
    {
      "name": "disjoint versions",
      "client": [
        2,
        3
      ],
      "catalog": "current",
      "expect": "reject",
      "code": "protocol_version_mismatch",
      "close": 4406
    },
    {
      "name": "catalog mismatch",
      "client": [
        1
      ],
      "catalog": "stale",
      "expect": "reject",
      "code": "catalog_version_mismatch",
      "close": 4406
    },
    {
      "name": "disjoint AND stale catalog",
      "client": [
        2
      ],
      "catalog": "stale",
      "expect": "reject",
      "code": "protocol_version_mismatch",
      "close": 4406
    }
  ],
  "extensionView": [
    {
      "name": "compatible server",
      "server": {
        "kind": "negotiated",
        "versions": [
          1
        ],
        "catalog": "current"
      },
      "expect": {
        "state": "READY",
        "protocolVersion": 1
      }
    },
    {
      "name": "server also speaks a newer version: greatest common",
      "server": {
        "kind": "negotiated",
        "versions": [
          1,
          2
        ],
        "catalog": "current"
      },
      "expect": {
        "state": "READY",
        "protocolVersion": 1
      }
    },
    {
      "name": "disjoint versions",
      "server": {
        "kind": "negotiated",
        "versions": [
          2,
          3
        ],
        "catalog": "current"
      },
      "expect": {
        "state": "BLOCKED",
        "code": "protocol_version_mismatch"
      }
    },
    {
      "name": "catalog mismatch",
      "server": {
        "kind": "negotiated",
        "versions": [
          1
        ],
        "catalog": "stale"
      },
      "expect": {
        "state": "BLOCKED",
        "code": "catalog_version_mismatch"
      }
    },
    {
      "name": "old legacy server speaking the unversioned wire",
      "server": {
        "kind": "legacy"
      },
      "expect": {
        "state": "BLOCKED",
        "code": "invalid_message"
      }
    }
  ]
}
